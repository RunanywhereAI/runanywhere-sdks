<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- macOS Network access for API calls and model downloads -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- macOS incoming TCP for Connect hosting (NWListener + Bonjour) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- macOS Camera access for VLM vision features -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- macOS Audio input access for voice features -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- macOS User-selected files for model imports (read-write) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- App Group for keyboard extension IPC (iOS + macOS) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.runanywhere.runanywhereai</string>
    </array>
    <!-- iOS HealthKit read access for the get_health_data tool -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.access</key>
    <array/>
    <!-- iOS raised jetsam ceiling. An on-device LLM is resident weights, not
         transient allocation: the 2.6B ANE bundle measures 3.21 GiB peak RSS
         (8-bit; the fp16 build is 5.72 GiB and does not fit a phone at all).
         Without this the app is jetsam-killed mid-load with no catchable error. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
</dict>
</plist>
