{
  // Electron main process. Emits CommonJS (electron-vite owns the emit; this
  // project exists for typechecking and editor resolution). Node APIs and the
  // `electron` module are in scope here — and only here plus the preload.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "electron.vite.config.ts"]
}
