# RunAnywhere backend credentials for telemetry/auth.
# Copy to `.env` (gitignored) and fill in real values, or leave blank.
#
# With both set, the app initializes in PRODUCTION (org-scoped, authed telemetry).
# With both blank, it initializes in DEVELOPMENT (keyless; telemetry goes to the
# public org). This mirrors the Android example's local.properties contract.
RUNANYWHERE_BASE_URL=
RUNANYWHERE_API_KEY=
