{
  // The renderer. Browser-only: no `node` types and no `electron` import (the
  // latter is also blocked by eslint's no-restricted-imports). Everything the
  // renderer needs arrives through the typed window.runanywhere / window.appStore
  // bridges declared in src/renderer/env.d.ts.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": [],
    // The renderer only ever imports SDK *types* (for the contextBridge surface
    // in env.d.ts); it never loads SDK code, which is Node-flavoured. Resolving
    // through node_modules to the published .d.ts is what makes that safe, and
    // `skipLibCheck` keeps those declarations from being re-checked in a
    // DOM-only project.
    //
    // `moduleResolution: bundler` reads package `exports`, so every dependency —
    // including `@runanywhere/proto-ts/defaults/pool`, which the exports map maps
    // to `dist/defaults/pool` — resolves with no alias at all. This block
    // deliberately overrides tsconfig.base's node10 shim, which the renderer does
    // not need and must not use.
    //
    // Run `npm install` if the SDK types resolve to nothing.
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.d.ts", "src/shared/**/*.ts"]
}
