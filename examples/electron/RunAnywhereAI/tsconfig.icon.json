{
  // The icon generator runs under Electron (it uses BrowserWindow to rasterize
  // the canonical logo.svg), so it is emitted as CommonJS and launched with
  // `electron`, not tsx.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "out/icon",
    "rootDir": "assets",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["assets/**/*.ts"]
}
