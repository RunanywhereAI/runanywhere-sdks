{
  // Emit config for the main process. Electron loads main as CommonJS, so tsc
  // emits CJS here and scripts/rename-cjs.mjs gives the entry a .cjs extension
  // (this package is "type": "module", so a bare .js would be treated as ESM).
  "extends": "./tsconfig.main.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"]
}
