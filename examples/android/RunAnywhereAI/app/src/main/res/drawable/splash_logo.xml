<?xml version="1.0" encoding="utf-8"?>
<!--
  The RunAnywhere mark, inset for the Android 12+ launch window's icon mask
  (values-v31/themes.xml → windowSplashScreenAnimatedIcon).

  The platform masks that slot to a circle of two thirds the canvas. In
  `runanywhere_logo.xml` the two chevrons span x 256..769 and y 227..797 of a 1024
  viewport, so their corners sit 383 units from the centre — a 767/1024 (74.9%)
  diameter, which the mask would clip at the tips.

  80dp of inset on each side makes the canvas 1184 units wide, putting the same
  corners at 64.7% and clear of the mask, without duplicating the path data.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/runanywhere_logo"
    android:inset="80dp" />
