<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The theme the app runs in. Every visible surface is drawn by Compose
         (ui/theme/Theme.kt), so this only has to set the window background to the
         same near-black the dark Compose scheme uses (Neutral6 #141414) and get
         out of the way. It was `android:Theme.Material.Light.NoActionBar`, whose
         white window flashed under a dark app. -->
    <style name="Theme.RunAnywhereAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_window_background</item>
    </style>

    <!-- The cold-start launch window (this is the activity's theme in the
         manifest; the activity swaps to Theme.RunAnywhereAI in onCreate).

         API 24-30 have no platform splash contract, so the launch window is just
         this `windowBackground`: the brand mark centred on the same near-black the
         app itself draws. values-v31 overrides it with the real
         `windowSplashScreen*` attributes on Android 12+.

         Deliberately NOT androidx.core:core-splashscreen. That library back-ports
         the API 31 contract and lets you hold the splash past first frame with
         `setKeepOnScreenCondition`; this app wants neither. A layer-list covers
         every pre-31 device, and holding the window open is exactly the wordless
         fourteen-second cold start that was just removed. -->
    <style name="Theme.RunAnywhereAI.Starting" parent="Theme.RunAnywhereAI">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
