#   1. What sherpa-onnx was built against
#   2. What's in runanywhere-swift/Binaries/onnxruntime.xcframework
# ONNX Runtime 1.29.0 was released on 2026-08-12, but its Apple pod archive is
# not published. 1.28.0 is the newest official static XCFramework available
# from download.onnxruntime.ai and is paired with Sherpa-ONNX 1.13.5 below.
ONNX_VERSION_IOS=1.28.0
ONNX_IOS_SHA256=b503cf5949ab718a1dff17d1643237ecc0fecf50ad86264572dcafddb140a327

# Android ONNX Runtime ships inside the pinned Sherpa-ONNX Android archive.
# The fork workflow builds that archive against this exact upstream source
# commit and validates the runtime before publishing it.
ONNX_VERSION_ANDROID=1.28.0
ONNX_COMMIT_ANDROID=da9b5e364c465de65c49d91e696cd6485270757f

# macOS release packaging needs a static archive. 1.28.0 is the newest
# published macOS static build; 1.29.0 currently ships only Microsoft's shared
# package. Keep this digest pinned to the exact csukuangfj build consumed by
# core/scripts/macos/download-sherpa-onnx.sh.
ONNX_VERSION_MACOS=1.28.0
ONNX_MACOS_STATIC_SHA256=e1b924acecf0cd42d1931e712bda1bc5fa0d111735dce265ea1bfdb024305318
# The third-party static archive omits this generated public header even
# though its own onnxruntime_c_api.h includes it. Fetch the missing file from
# the exact matching upstream tag and verify it before compiling Sherpa.
ONNX_MACOS_ERROR_CODE_HEADER_SHA256=5ce3b054e798eced8d14f5b86e98692fd33470463f96194ce0700a2d53dd8721

# Linux uses the same ORT ABI baseline as every other runtime target. Sherpa's
# fork-owned release below is built against this exact version.
ONNX_VERSION_LINUX=1.28.0

# Windows uses the same ORT ABI baseline as Linux, Apple, Android, and Web.
ONNX_VERSION_WINDOWS=1.28.0

# Web/WASM source builds use the common ORT 1.28.0 baseline too. 1.29.0 is not
# usable here because no matching static WASM/Apple release set is published.
ONNX_VERSION_WEB=1.28.0
ONNX_COMMIT_WEB=da9b5e364c465de65c49d91e696cd6485270757f

# =============================================================================
# Sherpa-ONNX (via runanywhere-core)
# =============================================================================
# iOS uses the static XCFramework published on upstream's rolling
# `xcframework` release. The downloader normalizes its framework-bundle layout
# back to the raw static-archive layout consumed by the CMake packager.
SHERPA_ONNX_VERSION_IOS=1.13.5
SHERPA_ONNX_IOS_SHA256=79214d00e275c864f0c4f7f9d1c252f8b621b185ceb54c13a43906da6f913080

# Android version (v1.12.20+ has 16KB alignment for Play Store)
# The downloader invalidates its cache whenever the repository, version,
# source/header commit, runtime commit, patch hash, or archive digest changes.
SHERPA_ONNX_VERSION_ANDROID=1.13.5-rac.4
# Android consumes the canonical-first RunAnywhere fork release. It retains
# the existing Whisper confidence behavior on upstream Sherpa 1.13.5, builds
# all four ABIs with NDK r27d against ORT 1.28.0, proves 16 KiB alignment, and
# rejects host build paths before publishing.
SHERPA_ONNX_REPO_ANDROID=RunanywhereAI/sherpa-onnx
SHERPA_ONNX_COMMIT_ANDROID=12f7112dc8f8161bdb611b31837bd47d70e4603f
SHERPA_ONNX_ANDROID_SHA256=f7e774d99f03bf51f11ee0b9c155f2737b98c5f299b0575c18821285a338edd5
# The fork commit is one behavior-only patch over this signed upstream commit.
# The SHA-256 is for the exact three-file git diff, not the release archive.
SHERPA_ONNX_UPSTREAM_COMMIT_ANDROID=3dc7c569f31ca2cd4a20ed6f7db780327e6714c5
SHERPA_ONNX_PATCH_SHA256_ANDROID=1348660905c79512a571fb11d5fb436485b8cb3e44de5fc3453dcc8ec8e0fcf7
# Public C/C++ headers are unchanged by the patch; fetch them from the signed
# upstream source commit instead of the fork's mutable release tag.
SHERPA_ONNX_HEADER_REPO_ANDROID=k2-fsa/sherpa-onnx
SHERPA_ONNX_HEADER_COMMIT_ANDROID=3dc7c569f31ca2cd4a20ed6f7db780327e6714c5

# Sherpa 1.13.5 contains the corrected NeMo streaming-transducer decode path
# required by Nemotron 3.5 Streaming ASR. The macOS builder links it against
# the exact ORT 1.28.0 static archive pinned above.
SHERPA_ONNX_VERSION_MACOS=1.13.5
SHERPA_ONNX_COMMIT_MACOS=3dc7c569f31ca2cd4a20ed6f7db780327e6714c5

# Linux and Windows consume fork-owned artifacts built from upstream 1.13.5
# against ORT 1.28.0. The release workflow builds all three artifacts before
# publishing, and the downloaders verify both archive checksums and embedded
# provenance before making them available to CMake.
SHERPA_ONNX_REPO_DESKTOP=RunanywhereAI/sherpa-onnx
SHERPA_ONNX_RELEASE_TAG_DESKTOP=v1.13.5-rac-desktop.4
SHERPA_ONNX_COMMIT_DESKTOP=c6531299b6c5816a95cb171a093e7f82847e59bb
SHERPA_ONNX_VERSION_LINUX=1.13.5
SHERPA_ONNX_LINUX_X64_SHA256=2fbadb68ecf45e73982ce20f18c4658639afc1db245ca1b5794accb6544b2fa2
SHERPA_ONNX_LINUX_AARCH64_SHA256=cb7167b68b4246f01a88d6661551ddb925b49481e39d8b329e6e7aee422f6345
SHERPA_ONNX_VERSION_WINDOWS=1.13.5
SHERPA_ONNX_WINDOWS_X64_SHA256=f3985b5b91536a8c06fafd3d0118479a09eaa71d4c95795424c5819162a913e9

# Web/WASM matched set with ONNX_VERSION_WEB. Do not reuse Android/iOS
