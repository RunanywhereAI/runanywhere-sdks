// Canonical proto error-category ranges, shared by commons and SDK codegen.
// Define RAC_ERROR_CATEGORY_RANGE(first, last, category) before including.
// Unmapped magnitudes (including zero) are UNSPECIFIED.
RAC_ERROR_CATEGORY_RANGE(100, 109, CONFIGURATION)
RAC_ERROR_CATEGORY_RANGE(110, 129, MODEL)
RAC_ERROR_CATEGORY_RANGE(130, 149, INTERNAL)
RAC_ERROR_CATEGORY_RANGE(150, 179, NETWORK)
RAC_ERROR_CATEGORY_RANGE(180, 219, IO)
RAC_ERROR_CATEGORY_RANGE(220, 229, INTERNAL)
RAC_ERROR_CATEGORY_RANGE(230, 249, COMPONENT)
RAC_ERROR_CATEGORY_RANGE(250, 279, VALIDATION)
RAC_ERROR_CATEGORY_RANGE(280, 299, IO)
RAC_ERROR_CATEGORY_RANGE(300, 319, COMPONENT)
RAC_ERROR_CATEGORY_RANGE(320, 349, AUTH)
RAC_ERROR_CATEGORY_RANGE(350, 369, IO)
RAC_ERROR_CATEGORY_RANGE(370, 379, VALIDATION)
RAC_ERROR_CATEGORY_RANGE(380, 389, INTERNAL)
RAC_ERROR_CATEGORY_RANGE(400, 499, COMPONENT)
RAC_ERROR_CATEGORY_RANGE(500, 599, CONFIGURATION)
RAC_ERROR_CATEGORY_RANGE(600, 699, COMPONENT)
RAC_ERROR_CATEGORY_RANGE(700, 999, INTERNAL)
