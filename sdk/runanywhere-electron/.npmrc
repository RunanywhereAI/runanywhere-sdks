# Copy file: dependencies into node_modules instead of symlinking them.
#
# @runanywhere/proto-ts is a file: dep on ../shared/proto-ts. Node resolves a
# symlinked package's own requires from its REAL path, so proto-ts's
# @bufbuild/protobuf would be looked up under sdk/shared/, which this package's
# install never populates. Copying puts the realpath inside our node_modules,
# where the shared @bufbuild/protobuf already sits.
install-links=true
