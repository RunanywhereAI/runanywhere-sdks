# Mark every IDL-generated tree as generated so GitHub's diff viewer collapses
# it by default. Anyone auditing a PR sees only the hand-written changes + the
# set of files that rotated after regen. The CI drift check is the actual
# gatekeeper; this attribute is purely cosmetic.
#
# Paths match the output directories from idl/codegen/generate_*.sh.

# Swift
bindings/swift/Sources/RunAnywhere/Generated/**  linguist-generated=true -diff

# Kotlin
bindings/kotlin/src/commonMain/kotlin/com/runanywhere/sdk/generated/**  linguist-generated=true -diff
bindings/kotlin/build/generated/**  linguist-generated=true -diff

# Dart
bindings/flutter/packages/runanywhere/lib/generated/**  linguist-generated=true -diff

# TypeScript (RN + Web)
bindings/react-native/packages/core/src/generated/**  linguist-generated=true -diff
bindings/web/packages/core/src/generated/**  linguist-generated=true -diff
bindings/shared/proto-ts/src/**  linguist-generated=true -diff
bindings/shared/proto-ts/dist/**  linguist-generated=true -diff

# C++
core/src/generated/proto/**  linguist-generated=true -diff

# Mirror Nitrogen's existing output tree for consistency.
bindings/react-native/packages/*/nitrogen/generated/**  linguist-generated=true -diff

# Protobuf compiler outputs can appear in multiple SDK language targets.
**/*.pb.cc  linguist-generated=true -diff
**/*.pb.h  linguist-generated=true -diff
**/*.pb.dart  linguist-generated=true -diff
**/*.pbjson.dart  linguist-generated=true -diff
**/*.pbenum.dart  linguist-generated=true -diff
**/*.pbserver.dart  linguist-generated=true -diff
**/*.pb.swift  linguist-generated=true -diff

# Preserve review-comment bodies byte-for-byte, including quoted blank lines.
comments/PR_531_comments.md -whitespace
