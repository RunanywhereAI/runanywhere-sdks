{
  // Build + maintenance scripts. Node-only (no DOM), and `../dist/<module>` from
  // dist-scripts/x.js resolves to dist/<module>, which is what manual-resolve
  // needs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "scripts",
    "outDir": "dist-scripts",
    "declaration": false,
    "sourceMap": true,
    "noEmitOnError": true,
    "lib": ["ES2021"],
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
