{
  "name": "@runanywhere/electron",
  "version": "0.20.26",
  "description": "RunAnywhere Electron SDK — on-device LLM/VLM/STT/TTS/embeddings for Electron & Node (prebuilds: darwin-arm64, win32-x64; win32-arm64 QHexRT/Hexagon NPU).",
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./main": {
      "types": "./dist/process/main.d.ts",
      "default": "./dist/process/main.js"
    },
    "./preload": {
      "types": "./dist/process/preload.d.ts",
      "default": "./dist/process/preload.js"
    },
    "./host": {
      "types": "./dist/process/host.d.ts",
      "default": "./dist/process/host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prebuilds",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build:native-smoke": "tsc -p tsconfig.native.json",
    "bundle:native": "tsc -p tsconfig.bundle.json && node dist-scripts/bundle-native.js",
    "pretest": "npm run build && npm run build:test",
    "test": "node --enable-source-maps --test \"dist-test/unit/**/*.test.js\"",
    "pretest:feature": "npm run build && npm run build:test",
    "test:feature": "node --enable-source-maps --test \"dist-test/feature/**/*.test.js\"",
    "pretest:all": "npm run build && npm run build:test",
    "test:all": "node --enable-source-maps --test \"dist-test/unit/**/*.test.js\" \"dist-test/feature/**/*.test.js\"",
    "check:proto-ts": "node scripts/check-proto-ts.mjs",
    "typecheck": "npm run check:proto-ts && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.native.json --noEmit",
    "prepack": "npm run build && npm run bundle:native"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@runanywhere/proto-ts": "file:../proto-ts"
  },
  "peerDependencies": {
    "@runanywhere/proto-ts": "^0.20.26"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^43.1.1",
    "typescript": "^5.6.3"
  }
}
