{
  // Main, preload, and the catalog module: CommonJS on disk, because Electron
  // loads main and preload as CJS and the utility host `require()`s the catalog.
  // See bindings/electron/AGENTS.md, "Emit targets". The renderer is a separate
  // project (tsconfig.renderer.json) precisely because it emits ESM instead.
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/main.ts", "src/preload.ts", "src/catalog.ts"]
}
