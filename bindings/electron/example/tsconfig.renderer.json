{
  // The renderer emits ESM, which the page loads with <script type="module">.
  // It imports nothing at runtime — only `import type` from the SDK, which
  // erases — so tsc alone is enough and this app needs no bundler.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/renderer.ts"]
}
